@page "/events"
@using EventEaseApp.Models
@using EventEaseApp.Services

@inject EventService EventService
@inject NavigationManager Navigation

<PageTitle>Events</PageTitle>

<h1>Upcoming Events</h1>

@if (EventList == null)
{
    <p>Loading events...</p>
}
else
{
    <div class="row">
        @foreach (var ev in EventList)
        {
            <div class="col-md-4">
             
                @* Note: It is best practice to prefix C# variables with @ when passing them as parameters to components *@
                <EventCard Event="@ev" OnViewDetails="NavigateToEvent" />

            </div>
        }
    </div>
}

@code {
    private List<Event>? EventList;

    protected override async Task OnInitializedAsync()
    {
        // Fetch events from JSON file
        EventList = await EventService.GetEventsAsync();
    }

    private void NavigateToEvent(int eventId)
    {
        // Redirect to event details
        Navigation.NavigateTo($"/event/{eventId}");
    }
}