@using EventEaseApp.Models
@using EventEaseApp.Services

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <h5 class="card-title">@Event.Name</h5>
        <p class="card-text"><strong>Date:</strong> @Event.Date</p>
        <p class="card-text">@Event.Description</p>

        <!-- Two-Way Data Binding Example -->
        <div class="form-group mb-3">
            <label for="partySize">Expected Party Size:</label>
            <input type="number" id="partySize" class="form-control" @bind="PartySize" @bind:event="oninput" />
            <small class="text-muted">You are bringing @PartySize people.</small>
        </div>

        <button class="btn btn-primary" @onclick="GoToDetails">View Details</button>
    </div>
</div>

@code {
    [Parameter] public Event Event { get; set; }
    [Inject] public NavigationManager NavManager { get; set; }

    public int PartySize { get; set; } = 1;

    private void GoToDetails()
    {
        NavManager.NavigateTo($"/events/{Event.Id}");
    }
}
