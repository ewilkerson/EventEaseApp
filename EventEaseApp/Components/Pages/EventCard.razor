@using EventEaseApp.Models
@using EventEaseApp.Services

<div class="card shadow-sm mb-3">
    <div class="card-body">
        <h5 class="card-title"><strong>Name:</strong> @Event.Name</h5>
        <p class="card-text"><strong>Date:</strong> @Event.Date</p>
        <p class="card-text"><strong>Description:</strong> @Event.Description</p>

        <!-- Two-Way Data Binding Example -->
        <div class="form-group mb-3">
            <label for="partySize">Expected Party Size:</label>
            <input type="number" id="partySize" class="form-control" @bind="PartySize" @bind:event="oninput" />
            <small class="text-muted">You are bringing @PartySize people.</small>
        </div>
        <NavLink class="btn btn-primary" href="@($"/events/{Event.Id}")"   Match="NavLinkMatch.Prefix">View Details</NavLink>
        <!--
        <button class="btn btn-primary" @onclick="GoToDetails">View Details</button> 
        -->
    </div>
</div>

@code {
    [Parameter] public Event Event { get; set; }
    
    // Add this parameter to accept the method from the parent
    [Parameter] public EventCallback<int> OnViewDetails { get; set; } 

    public int PartySize { get; set; } = 1;

    private async Task GoToDetails()
    {
        // Trigger the callback, passing the event ID to the parent
        if (OnViewDetails.HasDelegate)
        {
            await OnViewDetails.InvokeAsync(Event.Id);
        }
    }
}