@page "/events/{EventId:int}"
@using EventEaseApp.Models
@using EventEaseApp.Services
@inject EventService EventService
@inject SessionState SessionState
@inject NavigationManager Navigation


<h3>Event Details</h3>

@if (SelectedEvent == null)
{
    <p><em>Loading event or event not found...</em></p>
}
else
{
<div class="card shadow-sm mb-3">
    <div class="card-body">
  <!--  <RegistrationForm EventId="@SelectedEvent.Id" /> --> 
    
          <h5 class="card-title"><strong>Name:</strong> @SelectedEvent.Name</h5>
        <p class="card-text"><strong>Date:</strong> @SelectedEvent.Date</p>
        <p><strong>Location:</strong> @SelectedEvent.Location</p>
        <p class="card-text"><strong>Description:</strong> @SelectedEvent.Description</p>

  
                <h3 class="mt-4">Attendees</h3>
                @if (Attendees.Any())
                {
                    <ul>
                        @foreach (var attendee in Attendees)
                        {
                            <li>@attendee.Name (@attendee.Email)</li>
                        }
                    </ul>
                }
                else
                {
                    <p>No attendees registered yet.</p>
                }

                <NavLink class="btn btn-secondary" href="@($"/events")"   Match="NavLinkMatch.Prefix">Back to Events</NavLink>
 <!--       
<button class="btn btn-secondary mt-3" @onclick="NavigateBack">Back to Events</button>
-->
</div>
</div>
}

@code {
    [Parameter] 
    public int EventId { get; set; }
    private Event SelectedEvent;
    private List<Attendee> Attendees = new List<Attendee>();

    protected override async Task OnInitializedAsync()
    {
        // Fetch event details from EventService
        SelectedEvent = await EventService.GetEventByIdAsync(EventId);

                // Get attendees from SessionState
        Attendees = SessionState.GetAttendeesForEvent(EventId);

    }

    private void NavigateBack()
    {
        Navigation.NavigateTo("/events");
    }

}