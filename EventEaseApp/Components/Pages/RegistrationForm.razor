@using EventEaseApp.Models
@using EventEaseApp.Services
@inject SessionState SessionState
@inject NavigationManager Navigation

<EditForm Model="@registration" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    <div class="mb-3">
        <label>Name:</label>
        <InputText @bind-Value="registration.Name" class="form-control" @bind-Value="Registration.Name" />
        <ValidationMessage For="@(() => registration.Name)" />
    </div>
    <div class="mb-3">
        <label>Email:</label>
        <InputText @bind-Value="registration.Email" class="form-control" @bind-Value="Registration.Email" />
        <ValidationMessage For="@(() => registration.Email)" />
    </div>

      <div class="mb-3">
            <label for="eventId" class="form-label">Event ID</label>
            <InputNumber id="eventId" class="form-control" @bind-Value="registration.EventId"  />
            <ValidationMessage For="@(() => registration.EventId)" />
        </div>


    <button type="submit" class="btn btn-success">Register for Event</button>
</EditForm>

@if (isRegistered)
{
    <div class="alert alert-success mt-3">Successfully registered!</div>
}

@code {
    [Parameter] public int EventId { get; set; }
    private Registration registration = new();
    private bool isRegistered = false;

    protected override void OnInitialized()
    {
        registration.EventId = EventId;
    }

    private void HandleValidSubmit()
    {
                // Register attendee in SessionState
        SessionState.RegisterAttendee(registration);

        Console.WriteLine($"User registered: Name = {registration.Name}, Email = {registration.Email}, Event ID = {registration.EventId}");
        Navigation.NavigateTo($"/event/{registration.EventId}"); // Redirect to the event details page

        SessionState.RegisterAttendee(registration);
        isRegistered = true;
        registration = new Registration { EventId = this.EventId }; // Reset form
    }
}