@page "/RegistrationForm/{EventId:int}"
@using EventEaseApp.Models
@using EventEaseApp.Services
@inject SessionState SessionState
@inject NavigationManager Navigation

<EditForm Model="@registration" OnValidSubmit="HandleValidSubmit" FormName="RegistrationForm">
    <h5>Register for Event</h5>
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" />

    <div class="mb-3">
        <label>Name:</label>
        <InputText @bind-Value="registration.Name" class="form-control" />
        <ValidationMessage For="@(() => registration.Name)" />
    </div>
    <div class="mb-3">
        <label>Email:</label>
        <InputText @bind-Value="registration.Email" class="form-control" />
        <ValidationMessage For="@(() => registration.Email)" />
    </div>

    <NavLink class="btn btn-secondary" href="@($"/events/{EventId}")" Match="NavLinkMatch.Prefix">Back to Events</NavLink>
    &nbsp;&nbsp;&nbsp;&nbsp;
    <button type="submit" class="btn btn-success">Register for Event</button>
</EditForm>

@if (isRegistered)
{
    <div class="alert alert-success mt-3">Successfully registered!</div>
}

@code {
    [Parameter] public int EventId { get; set; }
    
    private Registration registration = new();
    private bool isRegistered = false;

    protected override void OnInitialized()
    {
        registration.EventId = EventId;
    }

    private async Task HandleValidSubmit()
    {
        // 1. Await the method directly instead of assigning 'void' to a Task variable.
        // 2. Assuming AddAttendeeAsync is inside an injected service like SessionState:
        await SessionState.AddAttendeeAsync(EventId, registration);

        Console.WriteLine($"User registered: Name = {registration.Name}, Email = {registration.Email}, Event ID = {registration.EventId}");
        
        isRegistered = true;
        
        // 3. Moved the closing brace to a new line so it isn't commented out
      //  registration = new Registration { EventId = this.EventId }; // Reset form
        
        Navigation.NavigateTo($"/event/{registration.EventId}"); // Redirect to the event details page
        
    }
}